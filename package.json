{
	"name": "bamboo-launcher",
	"version": "0.1.0",
	"packageManager": "pnpm@11.13.0",
	"description": "Modern Minecraft Launcher",
	"author": "Boris",
	"license": "MIT",
	"main": "main.js",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"electron": "electron .",
		"dist": "electron-builder",
		"release": "npm run build && electron-builder",
		"postinstall": "cd server && npm install",
		"server:start": "cd server && node start.js",
		"server:stop": "cd server && node stop.js",
		"start": "cd server && node render-entry.js",
		"stop": "npm run server:stop"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.2",
		"@xhayper/discord-rpc": "^1.3.4",
		"adm-zip": "^0.4.16",
		"framer-motion": "^12.42.2",
		"lucide-react": "0.475.0",
		"minecraft-launcher-core": "^3.18.2",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"skinview3d": "^3.4.2",
		"tailwindcss": "^4.3.2"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^24.12.3",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"electron": "^31.7.7",
		"electron-builder": "^26.0.12",
		"eslint": "^10.3.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"globals": "^17.6.0",
		"typescript": "~6.0.2",
		"typescript-eslint": "^8.59.2",
		"vite": "^8.0.12"
	},
	"build": {
		"appId": "de.bamboo.launcher.app",
		"productName": "Bamboo Launcher",
		"copyright": "Copyright © 2026 Boris",
		"directories": {
			"output": "release"
		},
		"files": [
			"dist/**/*",
			"main.js",
			"preload.js",
			"package.json",
			"assets/**/*",
			"resources/**/*"
		],
		"asar": true,
		"win": {
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				}
			],
			"icon": "src/assets/icon.ico"
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true,
			"createDesktopShortcut": true,
			"createStartMenuShortcut": true,
			"shortcutName": "Bamboo Launcher"
		}
	}
}
