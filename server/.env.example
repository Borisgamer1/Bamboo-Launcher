# ============================================================
# Bamboo Backend — Environment Variables
# ============================================================
# Copy this to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ---- PostgreSQL (Neon) ----
# Get these from your Neon Dashboard → Connection Details → PSQL
DB_HOST=ep-xxxxx.eu-west-1.aws.neon.tech
DB_PORT=5432
DB_NAME=bamboo_launcher
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# ---- JWT Secret ----
# Generate with: openssl rand -hex 32
JWT_SECRET=your-random-jwt-secret-here

# ---- Server Ports ----
# On Render: PORT is set automatically. Use 10000 for all internal ports.
# On local dev: defaults are fine.
PORT=10000
ADMIN_PORT=10000
FRIENDS_PORT=10000
FRIENDS_WS_PORT=10000

# ---- Content Storage ----
# On Render (Linux): use /tmp/ paths (ephemeral, rebuilt on each deploy)
# On local Windows: defaults are auto-detected
BAMBOO_CONTENT_DIR=/tmp/bamboo-content
BAMBOO_CONTENT_REPO=/tmp/bamboo-content
BAMBOO_COSMETIC_DIR=/tmp/bamboo-cosmetic-models

# ---- Launcher ----
VITE_API_HOST=localhost
VITE_API_PORT=3005
VITE_API_PROTOCOL=http
VITE_LAUNCHER_KEY=
