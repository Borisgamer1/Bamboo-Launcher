# ============================================================
# Bamboo Launcher Backend — Environment Variables
# ============================================================
# Kopiere diese Datei nach .env und passe die Werte an.
# Für Render: Setze diese Variablen im Render Dashboard.
# ============================================================

# Server Ports
PORT=3001
ADMIN_PORT=3001
FRIENDS_PORT=3400
FRIENDS_WS_PORT=3401

# PostgreSQL Database (Render: interne DB-Verbindungsdaten verwenden)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bamboo_launcher
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Secret (In Produktion durch einen starken, zufälligen Wert ersetzen!)
JWT_SECRET=bamboo-launcher-secret-change-in-production

# Node Environment
NODE_ENV=development

# Content & Storage
BAMBOO_CONTENT_DIR=./content
BAMBOO_SHARE_DIR=./share_storage
BAMBOO_MAX_SHARE_SIZE=524288000
BAMBOO_COSMETIC_DIR=./cosmetic_models
